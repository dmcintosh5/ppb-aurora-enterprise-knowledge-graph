<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/Form">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A required document for a process (e.g., Form 102-B).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/mentionedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://www.w3.org/2002/07/owl#Thing"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/DocumentChunk"/>
    <rdfs:comment>Traceability to source text.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/JobRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A specific professional position (e.g., Hotline Cook).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/employeeID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Employee"/>
    <rdfs:comment>Unique ID from HRIS.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/DocumentChunk">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A specific snippet of text from the source corpus.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/reportsTo">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Employee"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/Employee"/>
    <rdfs:comment>Hierarchical reporting line.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/appliesIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Policy"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/Region"/>
    <rdfs:comment>Links a policy to the region it governs.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/provenanceID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/DocumentChunk"/>
    <rdfs:comment>The source Document ID (e.g., PPB-HB-2026-V1).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/requiresForm">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/ProcessStep"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/Form"/>
    <rdfs:comment>A form needed to complete a step.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/accrualRate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Policy"/>
    <rdfs:comment>The mathematical rate of leave accrual.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/Policy">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A normative document governing employee conduct.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/locatedAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Employee"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/Location"/>
    <rdfs:comment>The physical site where an employee works.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/inRegion">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Location"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/Region"/>
    <rdfs:comment>Links a specific store to a state region.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/Department">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An organizational unit (e.g., Retail Operations).</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/SOP">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A standard operating procedure for a specific workflow.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/nextStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/ProcessStep"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/ProcessStep"/>
    <rdfs:comment>The sequence logic between steps.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/ProcessStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>An individual step within a multi-stage workflow.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/hasRole">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Employee"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/JobRole"/>
    <rdfs:comment>The role assigned to an employee.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/Employee">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A person working at Peachtree Pantry &amp; Beverage Co.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/requiresStep">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/SOP"/>
    <rdfs:range rdf:resource="http://peachtreepantry.com/ontology/ProcessStep"/>
    <rdfs:comment>Connects a process to its sequential steps.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/effectiveDate">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://peachtreepantry.com/ontology/Policy"/>
    <rdfs:comment>The date a policy became active.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/Location">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A physical store or regional office.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://peachtreepantry.com/ontology/Region">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment>A geographical state entity (GA, NY, VA).</rdfs:comment>
  </rdf:Description>
</rdf:RDF>
